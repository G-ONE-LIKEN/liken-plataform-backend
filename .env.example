POSTGRES_USER=liken_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=user_db

DB_USERNAME=liken_user
DB_PASSWORD=change-me-db-password

JWT_SECRET=change-me-jwt-secret-with-at-least-32-characters
GOOGLE_CLIENT_ID=

APP_SEED_ADMIN=true
APP_SEED_ADMIN_EMAIL_1=local-admin-1@example.test
APP_SEED_ADMIN_PASSWORD_1=change-me-admin-password
APP_SEED_ADMIN_EMAIL_2=local-admin-2@example.test
APP_SEED_ADMIN_PASSWORD_2=change-me-admin-password-2

FRONTEND_URL=http://localhost:3000
GCP_PROJECT_ID=liken-dev
GCS_BUCKET_NAME=liken-documents
GCS_EMULATOR_HOST=http://fake-gcs:4443
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# -----------------------------------------------------------------------------
# Notificaciones por email
# -----------------------------------------------------------------------------
# SMTP recomendado: Resend
# Configura tus credenciales SMTP verificadas en Resend:
#
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_USERNAME=resend
# MAIL_PASSWORD=tu-resend-smtp-password
# MAIL_AUTH=true
# MAIL_SSL=true
# MAIL_STARTTLS=false
# MAIL_FROM=tu-remitente-verificado-en-resend
# MAIL_FROM_NAME=LIKEN

# -----------------------------------------------------------------------------
# Blockchain (Sepolia)
# -----------------------------------------------------------------------------

# Usar alchemy, si el poll es cada 6 segundos, las rpcs publica pueden banear tu I.P.
# Si no tenes una cuenta de alchemy pedir la key a Fede.
WEB3_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY_AQUI
WEB3_CHAIN_ID=11155111

WEB3_POLL_SECONDS=6
WEB3_CONFIRMATIONS=2

# Addresses de los contratos globales deployados
LKN_ADDRESS=
REGISTRY_ADDRESS=
DISTRIBUTOR_ADDRESS=
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Publicacion on-chain de proyectos desde blockchain-service
# Wallet que firma el deploy/publicacion del OfferingContract.
PUBLICATION_SIGNER_PRIVATE_KEY=

# Address admin de plataforma. Para primeras pruebas locales conviene que
# coincida con la misma wallet del signer.
PLATFORM_ADMIN=

# Wallet emisora que deposita LKN en el offering y abre la ronda.
EMISOR_ADDRESS=

# Wallet treasury que recibe el USDC de la venta primaria y desde donde salen
# los refunds si la ronda falla.
TREASURY_ADDRESS=

# Ruta al workspace Foundry de contratos dentro del runtime del blockchain-service.
PUBLICATION_CONTRACTS_WORKSPACE=/contracts

# Binario de Foundry usado para ejecutar scripts.
FORGE_COMMAND=forge

# Script que publica un proyecto existente del backend.
PUBLICATION_SCRIPT_ENTRY=script/DeployProjectOffering.s.sol:DeployProjectOffering

# Zona horaria usada para convertir expectedOpenDate a deadline on-chain.
PUBLICATION_DEADLINE_ZONE_ID=America/Argentina/Buenos_Aires

# Opcionales si queres overridear URLs internas en local fuera de docker-compose.
BLOCKCHAIN_SERVICE_URL=http://blockchain-service:8085
PROJECT_SERVICE_URL=http://project-service:8082
USER_SERVICE_URL=http://user-service:8080
