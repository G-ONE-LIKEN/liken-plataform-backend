meta {
  name: login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@admin.com",
    "password": "admin123"
  }
}

script:post-response {
  if (res.status === 200) {
    const token = res.body.data?.accessToken;
    if (token) bru.setEnvVar("accessToken", token);
  }
}
