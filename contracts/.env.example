# Copiar a .env y completar. NUNCA commitear .env

# ── Red ──────────────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Wallet ───────────────────────────────────────────────────────────────────
# Recomendado: usar cuenta nombrada con cast wallet para no exponer la clave.
#   cast wallet import dev --interactive
#   forge script ... --account dev --broadcast
#
# Alternativa (menos seguro): pasar --private-key por CLI, nunca en este archivo.
DEPLOYER_ADDRESS=

# ── Roles (podés usar la misma wallet para los 3 en Sepolia/dev) ─────────────
# IMPORTANTE: en DeployAll y DeployProjectOffering, la wallet que firma (broadcaster)
# debe coincidir con EMISOR, porque el script llama deposit() y openRound().
PLATFORM_ADMIN=
EMISOR=
TREASURY=

# ── USDC ─────────────────────────────────────────────────────────────────────
# Sepolia (Circle oficial): 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Local (Anvil): dejar en 0x0 para que DeployAll deployee un MockUSDC
USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── Etherscan (para --verify después del deploy) ─────────────────────────────
# Conseguila en https://etherscan.io → My Account → API Keys
ETHERSCAN_API_KEY=

# ── Parámetros del proyecto (usados por DeployAll y DeployProjectOffering) ───
PROJECT_NAME=
PROJECT_DESCRIPTION=
PROJECT_OWNER=

# Precios en USDC con 6 decimales. Ej: 8000000 = $8 / LKN
EARLY_BIRD_PRICE=
STANDARD_PRICE=
# TOKEN_PRICE es opcional: si no se define usa EARLY_BIRD_PRICE
# TOKEN_PRICE=

# Caps en USDC con 6 decimales. Ej: 500000000000 = $500k
SOFT_CAP=
HARD_CAP=

# LKN a depositar en escrow, 18 decimales. Ej: 200000000000000000000000 = 200_000 LKN
ESCROW_LKN_AMOUNT_WEI=

# Deadline como Unix timestamp. Para obtener "+30 días desde ahora":
#   date -d '+30 days' +%s        (Linux)
#   date -v+30d +%s               (macOS)
DEADLINE_TIMESTAMP=

# ── Direcciones post-deploy (completar después de correr DeployCore) ─────────
# LKN_ADDRESS=
# REGISTRY_ADDRESS=
# USDC_ADDRESS=
# DISTRIBUTOR_ADDRESS=

# ── Direcciones post-deploy (completar después de correr DeployProjectOffering) ──
# OFFERING_ADDRESS=
