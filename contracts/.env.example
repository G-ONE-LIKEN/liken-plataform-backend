# Copiar a .env y completar. NUNCA commitear .env

# ── Red ──────────────────────────────────────────────────────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Wallet ───────────────────────────────────────────────────────────────────
# Tu address de MetaMask
DEPLOYER_ADDRESS=

# Tu private key (solo si no usás cuenta nombrada con `cast wallet import`)
# PRIVATE_KEY=

# ── Roles (podés usar la misma wallet para los 3 mientras se testea) ─────────
PLATFORM_ADMIN=
EMISOR=
TREASURY=

# ── USDC ─────────────────────────────────────────────────────────────────────
# Sepolia (Circle oficial): 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Local (Anvil): dejar en 0x0 para que el script deployee un MockUSDC
USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── Etherscan (para verificar contratos después del deploy) ──────────────────
# Conseguila en https://etherscan.io → My Account → API Keys
ETHERSCAN_API_KEY=

# ── Direcciones post-deploy (completar después de correr DeployAll) ──────────
# LINKEN_ADDRESS=
# REGISTRY_ADDRESS=
# OFFERING_ADDRESS=
# DISTRIBUTOR_ADDRESS=
