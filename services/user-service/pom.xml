<?xml version="1.0" encoding="UTF-8"?>
<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation=
	"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.2.4</version>
		<relativePath/>
	</parent>

	<groupId>com.plataforma</groupId>
	<artifactId>rbac-springboot</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>rbac-springboot</name>

	<properties>
		<java.version>21</java.version>
		<postgresql.version>42.7.5</postgresql.version>
		<flyway.version>10.10.0</flyway.version>
		<gcs.sdk.version>2.40.1</gcs.sdk.version>
	</properties>

	<!-- ================================================================
	     DEPENDENCIAS DE PRODUCCIoN
	     ================================================================ -->
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Flyway core + driver Postgres.
		     Desde Flyway 10.x, flyway-core no trae soporte para Postgres por default —
		     hay que sumar flyway-database-postgresql como dependencia explicita. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<version>${flyway.version}</version>
		</dependency>

		<!-- Google Cloud Storage — para upload de documentos KYC (DD013, DD014) -->
		<dependency>
			<groupId>com.google.cloud</groupId>
			<artifactId>google-cloud-storage</artifactId>
			<version>${gcs.sdk.version}</version>
		</dependency>

		<!-- Kafka — para consumir user.tier_changed publicado por invest-dividend (DD010) -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<!-- web3j-crypto — solo crypto/keys, sin stack web3 entera.
		     Usado por WalletLinkingService para verificar firmas EIP-191 (personal_sign)
		     y derivar la direccion EIP-55 a partir de la firma (ecrecover). -->
		<dependency>
			<groupId>org.web3j</groupId>
			<artifactId>crypto</artifactId>
			<version>4.10.3</version>
		</dependency>

		<!-- ============================================================
		     DEPENDENCIAS DE TEST
		     ============================================================ -->

		<!-- Spring Boot Test: JUnit 5 + Mockito + MockMvc + AssertJ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			H2: base de datos en memoria para tests @Tag("unit").
			No requiere Docker ni proceso externo.
		-->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Logs JSON estructurados para parsear con jq / shipear a Loki/ELK -->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>7.4</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
	</dependencies>

	<!-- ================================================================
	     BUILD DEFAULT
	     mvn test → solo tests @Tag("unit")  (rapido, sin Docker)
	     ================================================================ -->
	<build>
		<finalName>app</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!--
				Surefire default: perfil "test" (H2, sin Docker).
				Excluye el grupo "integration" para que mvn test sea siempre rapido.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludedGroups>integration</excludedGroups>
					<systemPropertyVariables>
						<spring.profiles.active>test</spring.profiles.active>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>1.18.30</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<!--
			Perfil "integration"
			- Agrega flyway-database-postgresql necesario para Postgres real.
			- Reconfigura Surefire para correr SOLO @Tag("integration").
			- Activa el perfil Spring "integration" → application-integration.properties.
			- Prerequisito: `docker compose up -d` corriendo antes de ejecutar.
		-->
		<profile>
			<id>integration</id>
			<dependencies>
				<dependency>
					<groupId>org.flywaydb</groupId>
					<artifactId>flyway-database-postgresql</artifactId>
					<version>${flyway.version}</version>
					<scope>test</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<groups>integration</groups>
							<excludedGroups>unit</excludedGroups>
							<systemPropertyVariables>
								<spring.profiles.active>integration</spring.profiles.active>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

	</profiles>

</project>
